# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily search API key - https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Any current Groq-hosted model with tool-calling support
GROQ_MODEL=openai/gpt-oss-20b

# Optional
MAX_SOURCES=3            # pages the reader scrapes per report
RATE_LIMIT_PER_HOUR=20   # web reports per client IP per hour
